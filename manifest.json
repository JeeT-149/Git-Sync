{
  "manifest_version": 3,
  "name": "GitSync",
  "key": "",
  "version": "1.0.0",
  "description": "Automatically sync your accepted LeetCode solutions to GitHub.",
  "permissions": [
    "storage",
    "identity",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "https://leetcode.com/*",
    "https://*.leetcode.com/*",
    "https://assets.leetcode.com/*",
    "https://api.github.com/*",
    "https://git-sync-auth-broker.vercel.app/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "GitSync",
    "default_popup": "src/popup/index.html"
  },
  "options_page": "src/options/index.html",
  "content_scripts": [
    {
      "matches": [
        "https://leetcode.com/*",
        "https://*.leetcode.com/*"
      ],
      "js": ["src/content/content.js"],
      "run_at": "document_idle",
      "world": "ISOLATED"
    },
    {
      "matches": [
        "https://leetcode.com/*",
        "https://*.leetcode.com/*"
      ],
      "js": ["src/content/page-bridge.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/sync/*",
        "src/docs/*",
        "src/platforms/*"
      ],
      "matches": [
        "https://leetcode.com/*"
      ]
    }
  ]
}